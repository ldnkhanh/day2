@model IEnumerable<Product>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="container mt-4">
    <h2 class="mb-3">Quản lý sản phẩm</h2>

    <table class="table table-bordered align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Genre</th>
                <th>Platform</th>
                <th>Price</th>
                <th>Created At</th>
                <th>Image</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Genre</td>
                    <td>@item.Platform</td>
                    <td>@(item.Price == 0 ? "Miễn phí" : item.Price.ToString("N0") + " đ")</td>
                    <td>@item.CreatedAt.ToString("dd-MM-yyyy")</td>
                    <td>
                        <img src="@item.ImageUrl" alt="@item.Name" style="width:80px;height:60px;object-fit:contain;"
                             onerror="this.src='https://placehold.co/80x60?text=No+Image'" />
                    </td>
                    <td>
                        <a asp-controller="Product" asp-action="View" asp-route-id="@item.Id"
                           class="btn btn-success btn-sm">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
