@model IEnumerable<Product>
@{
    ViewData["Title"] = "Trang chủ";
}

<div id="mainCarousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="2"></button>
    </div>

    <div class="carousel-inner banner-inner">
        <div class="carousel-item active">
            <div class="banner-slide">
                <h1 class="banner-title">Cửa hàng game bản quyền</h1>
                <p class="banner-desc">
                    Kho game đa nền tảng PC, PlayStation, Xbox, Nintendo Switch. Giao key tự động, giá tốt mỗi ngày.
                </p>
                <a class="btn btn-light" href="#danh-sach-san-pham">Xem thêm</a>
            </div>
        </div>
        <div class="carousel-item">
            <div class="banner-slide">
                <h1 class="banner-title">Sale cuối tuần</h1>
                <p class="banner-desc">Giảm giá đến 50% cho hàng loạt game AAA, số lượng có hạn.</p>
                <a class="btn btn-light" href="#danh-sach-san-pham">Xem thêm</a>
            </div>
        </div>
        <div class="carousel-item">
            <div class="banner-slide">
                <h1 class="banner-title">Game miễn phí hot nhất</h1>
                <p class="banner-desc">Trải nghiệm ngay các tựa game free-to-play được yêu thích nhất.</p>
                <a class="btn btn-light" href="#danh-sach-san-pham">Xem thêm</a>
            </div>
        </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>

<div class="container mt-4" id="danh-sach-san-pham">
    <h2 class="mb-3">Danh sách sản phẩm</h2>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-3 col-sm-6 mb-4">
                <div class="card h-100 product-card">
                    <img src="@item.ImageUrl" class="card-img-top p-3" alt="@item.Name" onerror="this.src='https://placehold.co/300x200?text=No+Image'" />
                    <div class="card-body text-center">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text text-muted small">@item.Genre &middot; @item.Platform</p>
                        <p class="card-text fw-bold">
                            @(item.Price == 0 ? "Miễn phí" : item.Price.ToString("N0") + " đ")
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
